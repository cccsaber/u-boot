if TARGET_H20PLUS

config SYS_BOARD
	default "h20plus"

config SYS_VENDOR
	default "rockchip"

config SYS_CONFIG_NAME
	default "h20plus"

config BOARD_SPECIFIC_OPTIONS
	def_bool y

config H20PLUS_FIT_ATF1_OVERRIDE
	string
	default "board/rockchip/h20plus/firmware/bl31_0x00080000.bin"
	help
	  Board-specific ATF-1 binary used only when packing uboot.img for
	  H20Plus. This keeps the H20Plus U-Boot DTB while overriding the
	  first BL31 payload with the known-good board-compatible build.

endif
